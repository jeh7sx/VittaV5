{
  "expo": {
    "name": "Vitta",
    "slug": "vitta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/img/logo.svg",
    "scheme": "vitta",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./src/img/logo.svg"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./src/img/logo.svg"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./src/img/logo.svg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser"
    ]
  }
}
